<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>ec.edu.uteq.soporte</groupId>
    <artifactId>auth-service</artifactId>
    <version>1.0.0</version>
    <name>auth-service</name>
    <description>Microservicio de autenticacion del PFC (equipo ACC) - registro, login, JWT y validacion de tokens</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Expone /actuator/prometheus con http_requests_total, http_request_duration_seconds
             (ver metrics/HttpMetricsFilter.java) y app_active_sessions (ver metrics/SessionMetrics.java):
             metricas exigidas por el Modulo F de la Guia de Entrega 4. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Logs en JSON estructurado (Modulo F, item 4). trace_id lo agrega el agente
             Java de OpenTelemetry (ver Dockerfile) en el MDC de Logback. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Emision/validacion de JWT (tokens de acceso) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- CockroachDB habla el protocolo de PostgreSQL: se usa el driver de postgresql -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Migraciones versionadas del esquema (Entregable 5 de la guia de cierre): antes el
             esquema lo creaban guiones sueltos de db-cluster/scripts/, no versionados como
             cambios: Flyway aplica db/migration/V1__*.sql automaticamente al arrancar,
             contra la misma base que ya declara spring.datasource. CockroachDB v21.1+ es
             compatible con Flyway 7.1+ (docs.cockroachlabs.com/docs/stable/flyway); se fija
             la version en vez de heredar la que administra el padre de Spring Boot, para no
             depender de que esa version en concreto siga soportando CockroachDB. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>9.22.3</version>
        </dependency>

        <!-- Publica "technician.created" cuando se da de alta un usuario TECNICO, para que
             ticket-service sincronice su propia tabla technicians (misma Saga por
             coreografia que ya usan ticket-service/ai-service/notification-service, ver
             ADR-0004). Antes de esto, un TECNICO creado desde el panel de Admin nunca
             llegaba a ticket_db y no se podia asignar (violaba la FK tickets_technician_id_fkey). -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Entregable 5 de la guia de cierre: ninguna prueba de este modulo aplicaba
             V1__init_auth_schema.sql contra un CockroachDB real, solo el arranque del stack
             completo en el job "integration" del CI; si esa migracion se rompiera, ninguna
             prueba de auth-service lo detectaria por su cuenta. Mismo patron que
             services/svc-principal (Testcontainers, no un cluster local ya corriendo). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Prueba de arquitectura (Entregable 1 de la guia de cierre, extendido a auth-service):
             falla la construccion si application/ vuelve a depender de infrastructure o de
             presentation. Ver architecture/DomainArchitectureTest.java. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.19.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>auth-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
