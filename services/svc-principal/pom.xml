<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>ec.edu.uteq.soporte</groupId>
    <artifactId>ticket-service</artifactId>
    <version>1.0.0</version>
    <name>ticket-service</name>
    <description>Microservicio principal del PFC (equipo ACC) - CRUD de tickets sobre cluster CockroachDB</description>

    <properties>
        <java.version>21</java.version>
        <grpc.version>1.62.2</grpc.version>
        <protobuf.version>3.25.1</protobuf.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Metricas Prometheus incrementales (D3.2 de la rubrica de Entrega 3):
             crdb_query_duration_seconds, crdb_transaction_retries_total,
             crdb_pool_active_connections. Ver config/CrdbMetrics.java. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Logs en JSON estructurado (Modulo F, item 4). El campo trace_id lo agrega el
             agente Java de OpenTelemetry (ver Dockerfile) escribiendolo en el MDC de
             Logback: logback-spring.xml solo necesita leerlo con %X{trace_id}. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>

        <!-- @Aspect para medir la duracion de cada consulta a TicketRepository sin
             tener que instrumentar cada metodo a mano (ver config/RepositoryTimingAspect.java) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- CockroachDB habla el protocolo de PostgreSQL: se usa el driver de postgresql -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Migraciones versionadas del esquema (Entregable 5 de la guia de cierre): antes el
             esquema lo creaban guiones sueltos de db-cluster/scripts/, no versionados como
             cambios: Flyway aplica db/migration/V1__*.sql automaticamente al arrancar,
             contra la misma base que ya declara spring.datasource. CockroachDB v21.1+ es
             compatible con Flyway 7.1+ (docs.cockroachlabs.com/docs/stable/flyway); se fija
             la version en vez de heredar la que administra el padre de Spring Boot, para no
             depender de que esa version en concreto siga soportando CockroachDB. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>9.22.3</version>
        </dependency>

        <!-- Saga por coreografia con ai-service: publica ticket.created, consume ticket.classified -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Cliente gRPC hacia telemetry-service (Adicion 1, estrategia c2: ver
             domain/correlation/ZonaVentanaTelemetriaStrategy.java y
             docs/adr/0008-correl-incidencias.md). Mismas versiones probadas ya en
             services/telemetry-service/pom.xml, solo que aqui es canal CLIENTE, no
             servidor: sin net.devh:grpc-server-spring-boot-starter. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>annotations-api</artifactId>
            <version>6.0.53</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers (D3.1 de la rubrica de Entrega 3, Modulo A paso 6): las
             pruebas de integracion levantan un CockroachDB real en Docker en vez de
             depender de un cluster local ya corriendo. Ver test/.../integration/. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Verificacion del lado PROVEEDOR del contrato Pact (Modulo D de la Guia de
             Entrega 4). Lee el archivo generado por el consumidor (apps/web, ver
             apps/web/tests/contract/ticketsApi.pact.test.ts -> pacts/soporte-web-ticket-service.json)
             y repite cada interaccion contra el ticket-service real. Ver
             contract/TicketServiceProviderPactTest.java para como se activa (no corre en
             un "mvn test" normal porque necesita el stack completo levantado). -->
        <dependency>
            <groupId>au.com.dius.pact.provider</groupId>
            <artifactId>junit5</artifactId>
            <version>4.7.5</version>
            <scope>test</scope>
        </dependency>

        <!-- Prueba de arquitectura (Entregable 1 de la guia de cierre): falla la construccion
             si domain/ vuelve a importar Spring o JPA. Ver
             architecture/DomainArchitectureTest.java. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.19.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>ticket-service</finalName>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Genera el cliente gRPC desde src/main/proto/telemetry.proto (mismo contrato
                 que services/telemetry-service, copiado sin cambios). -->
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>compile-custom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Cobertura de pruebas unitarias (Modulo A, salida esperada: "sube a >= 70%").
                 Antes vivia en un perfil "coverage" que no se activaba por defecto: el propio
                 flujo de CI corria "mvn test" sin ese perfil, asi que el pipeline nunca medía
                 pese a que este mismo comentario decia que el reporte "es usado por el pipeline",
                 y la ejecucion "check" no existia en ningun sitio: no habia ningun umbral que
                 subir ni bajar. Ahora el plugin esta siempre activo y la ejecucion "check" (ligada
                 a la fase test, no a la verify por defecto de JaCoCo, para que corra con el mismo
                 "mvn test" que ya usa el job test-backend del flujo) rompe la construccion si la
                 cobertura de instrucciones del modulo cae por debajo del 70% declarado como
                 objetivo. Verificado subiendo el umbral a 0.95 (por encima de la cobertura real):
                 "mvn test" fallo con "Rule violated for bundle ticket-service: instructions
                 covered ratio is 0.89, but expected minimum is 0.95" (revision externa: el
                 unico intento anterior de esta verificacion que quedo en el historial fallo por
                 "Non-parseable POM", un error de configuracion, no por la cobertura; esta vez
                 se corrio hasta el final y se revirtio el umbral a 0.70 despues). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <!-- Excluye el codigo generado automaticamente por protobuf/grpc-java a
                         partir de telemetry.proto (getters/setters/builders mecanicos, sin
                         logica propia, que nadie prueba a mano; practica estandar de
                         JaCoCo). Sin esta exclusion, el boilerplate generado diluia el
                         numero real de cobertura del codigo que si escribimos: bajaba de
                         59.3% (antes de este generador) a 42.7% (con el generador incluido,
                         contando en contra codigo que nunca se prueba por convencion),
                         cuando el codigo propio esta en realidad en 64.4% antes de las
                         pruebas de esta seccion. -->
                    <excludes>
                        <exclude>ec/edu/uteq/soporte/telemetryservice/infrastructure/grpc/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
