# Fe de erratas (Entregable 40 de la guia de cierre): el mensaje del commit 8d735d8
# ("fix(openapi): normaliza el contrato a finales de linea LF") anuncia una normalizacion que
# en realidad no ocurrio -- el blob de docs/api/openapi.yaml ya tenia 0 finales CRLF antes de
# ese commit, asi que el diff quedo vacio. No se reescribe el historial (8d735d8 ya esta
# publicado); esta nota documenta la discrepancia en vez de dejar el mensaje sin corregir en
# ningun lugar versionado, tal como senalo una revision externa del repositorio.
#
# Regla general de captura: cualquier archivo que Git detecte como texto y que no este
# cubierto por una regla explicita mas abajo se normaliza a LF al entrar al historial. Sin
# esta linea, una extension nueva entra al repositorio sin atributo y vuelve a quedar sujeta
# al sistema operativo de quien la commitea, que es el problema que este archivo evita.
* text=auto eol=lf

# Fija los finales de linea de los datos tabulares del experimento a LF, sin importar el
# sistema operativo donde se generen o se clonen. Sin esto, un CSV generado en Windows (CRLF)
# y verificado en Linux (LF) -- o viceversa -- cambia de suma de verificacion sin que el
# contenido haya cambiado, que es justo el problema que este archivo evita.
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.tex text eol=lf

# Codigo fuente y configuracion: mismos finales de linea (LF) en todo el repositorio, sin
# importar el sistema operativo del integrante que edite. Sin esto, un archivo editado en
# Windows entra al historial en CRLF y el resto en LF, que es lo que ocurrio con secciones
# del manuscrito y con el contrato OpenAPI.
*.yaml text eol=lf
*.yml text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.proto text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.conf text eol=lf
*.bib text eol=lf
*.cff text eol=lf
*.pro text eol=lf
Dockerfile text eol=lf
gradlew text eol=lf

# Guiones de Windows: se declaran en CRLF a proposito, para que no queden indefinidos y
# cambien de finales segun el equipo donde se clone.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binarios: nunca se normalizan finales de linea (evita corromperlos).
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.exec binary
*.apk binary
*.docx binary
*.gif binary
*.jar binary
*.pptx binary
*.mp4 binary

# Archivos sin extension o con extension no cubierta arriba: se declaran uno por uno para
# que ningun archivo versionado quede sin atributo explicito.
.env.example    text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
LICENSE         text eol=lf
*.bbl           text eol=lf
*.blg           text eol=lf
*.ipynb         text eol=lf
